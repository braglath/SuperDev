<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SuperDev.App"
             xmlns:local="using:SuperDev"
             xmlns:controls="using:SuperDev.Controls"
             Name="Super Dev"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceInsetBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextBodyBrush" Color="#334155"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="TextSubtleBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="TextFaintBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D28D9"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#5B21B6"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#6D28D9"/>
        <SolidColorBrush x:Key="AccentTextHoverBrush" Color="#5B21B6"/>
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#F3EAFE"/>
        <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#E9D5FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="DangerTextHoverBrush" Color="#991B1B"/>
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="DangerSurfaceSoftBrush" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E8F7EE"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#86EFAC"/>
        <SolidColorBrush x:Key="InfoTextBrush" Color="#0369A1"/>
        <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="ReviewTextBrush" Color="#6D28D9"/>
        <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#EDE9FE"/>
        <x:Double x:Key="Font11">11</x:Double>
        <x:Double x:Key="Font12">12</x:Double>
        <x:Double x:Key="Font13">13</x:Double>
        <x:Double x:Key="Font14">14</x:Double>
        <x:Double x:Key="Font15">15</x:Double>
        <x:Double x:Key="Font16">16</x:Double>
        <x:Double x:Key="Font17">17</x:Double>
        <x:Double x:Key="Font18">18</x:Double>
        <x:Double x:Key="Font20">20</x:Double>
        <x:Double x:Key="Font22">22</x:Double>
        <x:Double x:Key="Font24">24</x:Double>
        <x:Double x:Key="Font28">28</x:Double>
        <x:Double x:Key="Font38">38</x:Double>
        <x:Double x:Key="Font92">92</x:Double>
        <x:Double x:Key="ControlHeight">40</x:Double>
        <x:Double x:Key="ControlHeightSm">36</x:Double>
        <x:Double x:Key="ControlHeightLg">44</x:Double>
        <x:Double x:Key="ControlHeightXl">52</x:Double>
        <x:Double x:Key="ControlHeightXs">32</x:Double>
        <x:Double x:Key="IconButtonSize">34</x:Double>
        <x:Double x:Key="SectionSpacing">24</x:Double>
        <Thickness x:Key="PageMargin">32</Thickness>
        <Thickness x:Key="PagePadding">24,28,24,40</Thickness>
        <Thickness x:Key="CardPadding">12</Thickness>
        <Thickness x:Key="HomePadding">28,8,28,32</Thickness>
        <x:Double x:Key="Space8">8</x:Double>
        <x:Double x:Key="Space12">12</x:Double>
        <x:Double x:Key="Space16">16</x:Double>
        <x:Double x:Key="Space24">24</x:Double>
        <x:Double x:Key="Space32">32</x:Double>
        <SolidColorBrush x:Key="CalendarViewForeground" Color="#0F172A"/>
        <SolidColorBrush x:Key="CalendarViewBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CalendarViewCalendarItemForeground" Color="#1E293B"/>
        <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="CalendarViewHoverBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="CalendarViewPressedBorderBrush" Color="#6D28D9"/>
        <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="CalendarViewSelectedHoverBorderBrush" Color="#6D28D9"/>
        <SolidColorBrush x:Key="CalendarViewSelectedPressedBorderBrush" Color="#5B21B6"/>
        <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CalendarViewOutOfScopeBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="CalendarViewOutOfScopeForeground" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CalendarViewBlackoutForeground" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CalendarViewWeekDayForegroundDisabled" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CalendarViewNavigationButtonBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="CalendarViewNavigationButtonBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="CalendarViewNavigationButtonBorderBrushPointerOver" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CalendarViewNavigationButtonForegroundPointerOver" Color="#0F172A"/>
        <SolidColorBrush x:Key="CalendarViewNavigationButtonForegroundPressed" Color="#5B21B6"/>
        <x:Double x:Key="CalendarFontSize">13</x:Double>
        <x:Double x:Key="CalendarDayButtonFontSize">13</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Drawn decorations sit outside the window tree, so these have to live on the app. -->
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>

        <Style Selector="Window">
            <Setter Property="Icon" Value="{DynamicResource AppWindowIcon}"/>
        </Style>

        <Style Selector="FlyoutPresenter.app-popup">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Calendar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="CalendarDayButton /template/ Border#Root">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="CalendarDayButton /template/ Border#Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="CalendarDayButton:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:pointerover /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:today:not(:selected) /template/ Border#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="CalendarDayButton:today:not(:selected) /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:today:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CalendarDayButton:selected /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:selected /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CalendarDayButton:inactive /template/ Border#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="CalendarDayButton:inactive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="CalendarButton:selected /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="CalendarButton:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="CalendarButton:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="CalendarButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="Button.clear-text">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.clear-text:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="(controls:TextBoxClearButton.Show)" Value="True"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="TextBox:disabled">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSm}"/>
        </Style>

        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="ComboBox:disabled">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
        </Style>

        <Style Selector="CheckBox:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
        </Style>

        <Style Selector="RadioButton:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="6"/>
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- Shared page frame. The tasklist view keeps its own margin. -->
        <Style Selector="Grid.page-frame">
            <Setter Property="Margin" Value="{DynamicResource HomePadding}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="StackPanel.page-column">
            <Setter Property="MaxWidth" Value="1040"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Application.Styles>
</Application>