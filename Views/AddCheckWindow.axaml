<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SuperDev.Models"
        xmlns:controls="using:SuperDev.Controls"
        x:Class="SuperDev.Views.AddCheckWindow"
        Width="500"
        Height="700"
        MinWidth="450"
        MinHeight="540"
        CanResize="True"
        Title="Add Check"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>

        <!-- Text -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Calendar TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:inactive TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:today:not(:selected) TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CalendarDayButton:selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Field labels -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <!-- Text input -->
        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightLg}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="TextBox.notes">
            <Setter Property="MinHeight" Value="140"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>

        <Style Selector="TextBox.notes:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.expand-notes">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.expand-notes:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
        </Style>

        <Style Selector="Button.expand-notes.late">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Button.deadline-clear">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.deadline-clear:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBox.reminder-time">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="(controls:TextBoxClearButton.Show)" Value="False"/>
        </Style>

        <Style Selector="Button.reminder-choice">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-choice.on">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-mode">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-mode.on">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-mode /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-mode.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-cancel">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-cancel /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="Button.reminder-set">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-set /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-cancel TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="Button.reminder-set TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-mode TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="Button.reminder-mode.on TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-choice TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="Button.reminder-choice.on TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Combo boxes -->
        <Style Selector="ComboBox.field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightLg}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Buttons -->
<Style Selector="Button.form-button">
    <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
    <Setter Property="MinWidth" Value="100"/>
    <Setter Property="Padding" Value="20,8"/>
    <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="8"/>

    <!-- Center button text -->
    <Setter Property="HorizontalContentAlignment"
            Value="Center"/>
    <Setter Property="VerticalContentAlignment"
            Value="Center"/>
</Style>

        <!-- Cancel -->
        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.cancel:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Save -->
        <Style Selector="Button.save">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.save:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Keep the scrollbar in its own gutter so it does not cover the right-side buttons. -->
        <Style Selector="ScrollViewer.form /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="AllowAutoHide" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="MaxWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollViewer.form /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineUpButton,
                         ScrollViewer.form /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <Style Selector="ScrollViewer.form /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Background" Value="{DynamicResource TextSubtleBrush}"/>
        </Style>

        <Style Selector="ScrollViewer.form /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true]">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="MaxWidth" Value="8"/>
        </Style>

        <Style Selector="ScrollViewer.form /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Thumb">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="TextBox.subtask-field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="(controls:TextBoxClearButton.Show)" Value="False"/>
        </Style>

        <Style Selector="TextBox.subtask-field:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Border.subtask-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style Selector="Border.subtask-row.dragging">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style Selector="Border.subtask-grip">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="TextBlock.subtask-grip-mark">
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="Button.subtask-remove">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.subtask-remove:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Button.link-requirement">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.link-requirement.on">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="*,Auto"
      Margin="30"
      RowSpacing="20">

    <ScrollViewer x:Name="FormScroll"
                  Grid.Row="0"
                  Classes="form"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="18"
          Margin="0,0,16,0">

            <!-- Check -->
            <StackPanel Grid.Row="1"
                        Spacing="6">
                <TextBlock Text="Check"
                           Classes="field-label"/>

                <TextBox x:Name="TitleTextBox"
                         Classes="field"
                         Watermark="Enter checklist item..."
                         TextChanged="TitleTextBox_TextChanged"/>
                <TextBlock x:Name="TitleError"
                           Text="A check with this title already exists."
                           FontSize="{DynamicResource Font12}"
                           Foreground="{DynamicResource DangerTextBrush}"
                           TextWrapping="Wrap"
                           IsVisible="False"/>
            </StackPanel>


            <StackPanel Grid.Row="0"
                        Spacing="6">
                <TextBlock Text="Deadline"
                           Classes="field-label"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <Button x:Name="DeadlineButton"
                        Content="Pick deadline"
                        Classes="expand-notes">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterClasses="app-popup"
                                Opened="DeadlineFlyout_Opened">
                            <StackPanel Spacing="10"
                                        Width="294"
                                        KeyDown="DeadlineEditor_KeyDown">
                                <Calendar x:Name="DeadlineCalendar"
                                          SelectionMode="SingleDate"/>
                                <TextBlock Text="Time"
                                           Classes="field-label"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBox x:Name="DeadlineHourBox"
                                             Classes="reminder-time"
                                             PlaceholderText="09"/>
                                    <TextBlock Text=":"
                                               FontSize="{DynamicResource Font16}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox x:Name="DeadlineMinuteBox"
                                             Classes="reminder-time"
                                             PlaceholderText="00"/>
                                    <Button x:Name="DeadlineAmButton"
                                            Classes="reminder-choice"
                                            Content="AM"
                                            Click="DeadlineMeridiem_Click"/>
                                    <Button x:Name="DeadlinePmButton"
                                            Classes="reminder-choice"
                                            Content="PM"
                                            Click="DeadlineMeridiem_Click"/>
                                </StackPanel>
                                <TextBlock Text="Notify"
                                           Classes="field-label"/>
                                <Grid ColumnDefinitions="*,*,*"
                                      ColumnSpacing="8">
                                    <Button x:Name="DeadlineNotifyNoneButton"
                                            Classes="reminder-mode"
                                            Content="None"
                                            Click="DeadlineNotify_Click"/>
                                    <Button x:Name="DeadlineNotifyOnButton"
                                            Grid.Column="1"
                                            Classes="reminder-mode"
                                            Content="On time"
                                            Click="DeadlineNotify_Click"/>
                                    <Button x:Name="DeadlineNotifyBeforeButton"
                                            Grid.Column="2"
                                            Classes="reminder-mode"
                                            Content="Before"
                                            Click="DeadlineNotify_Click"/>
                                </Grid>
                                <StackPanel x:Name="DeadlineLeadPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            IsVisible="False">
                                    <TextBox x:Name="DeadlineLeadBox"
                                             Classes="reminder-time"
                                             Width="72"
                                             MaxLength="3"
                                             Text="30"/>
                                    <Button x:Name="DeadlineLeadMinutesButton"
                                            Classes="reminder-mode"
                                            Content="minutes"
                                            Click="DeadlineLeadUnit_Click"/>
                                    <Button x:Name="DeadlineLeadHoursButton"
                                            Classes="reminder-mode"
                                            Content="hours"
                                            Click="DeadlineLeadUnit_Click"/>
                                </StackPanel>
                                <Button x:Name="DeadlineSilentButton"
                                        Classes="reminder-mode"
                                        Content="Silent"
                                        HorizontalAlignment="Left"
                                        MinWidth="120"
                                        Click="DeadlineSilent_Click"/>
                                <TextBlock Text="No sound for this deadline"
                                           FontSize="{DynamicResource Font11}"
                                           Foreground="{DynamicResource TextSubtleBrush}"/>
                                <TextBlock x:Name="DeadlineError"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font12}"
                                           Foreground="{DynamicResource DangerTextBrush}"
                                           IsVisible="False"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="Cancel"
                                            Classes="reminder-cancel"
                                            Click="DeadlineCancel_Click"/>
                                    <Button Content="Set"
                                            Classes="reminder-set"
                                            Click="DeadlineSet_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ClearDeadlineButton"
                        Classes="deadline-clear"
                        Content="×"
                        ToolTip.Tip="Clear deadline"
                        IsVisible="False"
                        Click="ClearDeadline_Click"/>
            </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="Category"
                               Classes="field-label"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Classes="field">
                        <ComboBoxItem Content="Understand"/>
                        <ComboBoxItem Content="Development"/>
                        <ComboBoxItem Content="Testing"/>
                        <ComboBoxItem Content="Communication"/>
                        <ComboBoxItem Content="PR"/>
                        <ComboBoxItem Content="Merge"/>
                        <ComboBoxItem Content="Deployment"/>
                        <ComboBoxItem Content="Closure"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Spacing="6">
                    <TextBlock Text="Priority"
                               Classes="field-label"/>
                    <ComboBox x:Name="PriorityComboBox"
                              Classes="field"
                              SelectionChanged="PriorityComboBox_SelectionChanged">
                        <ComboBoxItem Content="Critical" Foreground="{DynamicResource DangerTextBrush}"/>
                        <ComboBoxItem Content="Required" Foreground="{DynamicResource WarningTextBrush}"/>
                        <ComboBoxItem Content="Conditional" Foreground="{DynamicResource InfoTextBrush}"/>
                        <ComboBoxItem Content="Review" Foreground="{DynamicResource ReviewTextBrush}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3"
                        Spacing="6">
                <TextBlock Text="Type"
                           Classes="field-label"/>
                <ComboBox x:Name="TypeComboBox"
                          Classes="field">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Investigation"/>
                    <ComboBoxItem Content="Implementation"/>
                    <ComboBoxItem Content="Verification"/>
                    <ComboBoxItem Content="Documentation"/>
                </ComboBox>
                <TextBlock Text="What kind of work this check is. Leave it as None when it does not apply."
                           FontSize="{DynamicResource Font12}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Spacing="8">
                <TextBlock Text="References"
                           Classes="field-label"/>
                <TextBlock Text="Shown on the check only when filled. Paste an https link to open it from the checklist."
                           FontSize="{DynamicResource Font12}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Test reports" Classes="field-label"/>
                <TextBox x:Name="TestReportsTextBox"
                         Classes="notes"
                         MinHeight="72"
                         PlaceholderText="Report name, path, or link"/>
                <TextBlock Text="Logs" Classes="field-label"/>
                <TextBox x:Name="LogsTextBox"
                         Classes="notes"
                         MinHeight="72"
                         PlaceholderText="Log excerpt or link"/>
                <TextBlock Text="Code references" Classes="field-label"/>
                <TextBox x:Name="CodeReferencesTextBox"
                         Classes="notes"
                         MinHeight="72"
                         PlaceholderText="File, symbol, or link"/>
                <TextBlock Text="API responses" Classes="field-label"/>
                <TextBox x:Name="ApiResponsesTextBox"
                         Classes="notes"
                         MinHeight="72"
                         PlaceholderText="Response excerpt or link"/>
                <TextBlock Text="PR links" Classes="field-label"/>
                <TextBox x:Name="PullRequestLinksTextBox"
                         Classes="notes"
                         MinHeight="72"
                         PlaceholderText="Pull request link"/>
            </StackPanel>

            <StackPanel Grid.Row="7"
                        Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Evidence"
                               Classes="field-label"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Add from folder"
                            Classes="expand-notes"
                            Click="AddEvidence_Click"/>
                </Grid>
                <TextBlock Text="Screenshots and videos stay in the folder you pick. Super Dev remembers the path."
                           FontSize="{DynamicResource Font12}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="EvidenceEmpty"
                           Text="No evidence yet."
                           FontSize="{DynamicResource Font13}"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <controls:EvidenceGallery x:Name="EvidenceList"
                                          AllowRemove="True"/>
            </StackPanel>

            <StackPanel Grid.Row="8"
                        Spacing="8">
                <TextBlock Text="Linked checklists"
                           Classes="field-label"/>
                <TextBlock Text="Required links must be completed before this check can be completed. Optional links do not."
                           FontSize="{DynamicResource Font12}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           TextWrapping="Wrap"/>
                <Button Content="Link checklist"
                        Classes="expand-notes"
                        HorizontalAlignment="Left"
                        Click="LinkChecklist_Click"/>
                <ItemsControl x:Name="LinkList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChecklistSubtask">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,0,0,6">
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font14}"/>
                                <Button Grid.Column="1"
                                        Classes="link-requirement"
                                        Content="Required"
                                        Click="LinkRequirement_Click"
                                        Loaded="LinkRequirement_Loaded"/>
                                <Button Grid.Column="2"
                                        Classes="deadline-clear"
                                        Content="×"
                                        Click="RemoveLink_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <TextBlock Text="Subtasks"
                               Classes="field-label"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="Drag the handle to reorder"
                               FontSize="{DynamicResource Font12}"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <TextBox x:Name="SubtaskTextBox"
                             Classes="field"
                             PlaceholderText="Subtask"
                             KeyDown="SubtaskTextBox_KeyDown"/>
                    <Button Grid.Column="1"
                            Content="Add"
                            Classes="expand-notes"
                            Click="AddSubtask_Click"/>
                </Grid>
                <StackPanel x:Name="SubtaskList" Spacing="6"/>
            </StackPanel>

            <!-- Notes -->
            <Grid Grid.Row="4"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="6">

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Notes"
                               Classes="field-label"
                               VerticalAlignment="Center"/>

                    <Button x:Name="ExpandNotesButton"
                            Grid.Column="1"
                            Content="Expand"
                            Classes="expand-notes"
                            Click="ToggleNotes_Click"/>
                </Grid>

                <TextBox x:Name="NotesTextBox"
                         Grid.Row="1"
                         Classes="notes"
                         PlaceholderText="Add notes. Paste an https link to open it from the checklist."/>

            </Grid>

            <Grid Grid.Row="5"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="6">

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Acceptance"
                               Classes="field-label"
                               VerticalAlignment="Center"/>

                    <Button x:Name="ExpandAcceptanceButton"
                            Grid.Column="1"
                            Content="Expand"
                            Classes="expand-notes"
                            Click="ToggleAcceptance_Click"/>
                </Grid>

                <TextBox x:Name="AcceptanceTextBox"
                         Grid.Row="1"
                         Classes="notes"
                         MinHeight="96"
                         PlaceholderText="How you know this check is done. Paste an https link to open it from the checklist."/>

            </Grid>

    </Grid>

    </ScrollViewer>


    <!-- Fixed buttons -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
            <Button x:Name="GenerateAiButton"
                    Classes="form-button cancel"
                    MinWidth="0"
                    Padding="14,8"
                    HorizontalAlignment="Left"
                    IsVisible="False"
                    ToolTip.Tip="Draft this check with the local model"
                    Click="GenerateAi_Click">
                <controls:AiLabel Text="Generate" IconSize="20"/>
            </Button>
            <TextBlock x:Name="GenerateStatus"
                       FontSize="{DynamicResource Font12}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button Content="Cancel"
                    Classes="form-button cancel"
                    Click="Cancel_Click"/>

            <Button x:Name="SaveButton"
                    Content="Save"
                    Classes="form-button save"
                    Click="Save_Click"/>

        </StackPanel>
    </Grid>

</Grid>

</Window>