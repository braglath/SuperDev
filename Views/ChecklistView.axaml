<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SuperDev.Models"
             xmlns:controls="using:SuperDev.Controls"
             xmlns:views="using:SuperDev.Views"
             x:Class="SuperDev.Views.ChecklistView">

    <UserControl.Styles>

        <!-- Global -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Header -->
        <Style Selector="TextBox.page-title">
            <Setter Property="FontSize" Value="{DynamicResource Font24}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,4,2"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="(controls:TextBoxClearButton.WhenFocused)" Value="True"/>
        </Style>

        <Style Selector="TextBox.page-title:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style Selector="TextBox.page-title:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="TextBox.page-title:disabled">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="TextBox.page-title:disabled:pointerover, TextBox.page-title.locked:pointerover, TextBox.page-title.locked:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="TextBlock.meta-label">
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="TextBox.meta">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.meta:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="TextBox.reminder-count">
            <Setter Property="(controls:TextBoxClearButton.Show)" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Progress -->
        <Style Selector="TextBlock.progress-text">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="ProgressBar.progress">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Action buttons -->
        <Style Selector="Button.action">
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style Selector="Button.action.secondary">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.action.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.action.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.action.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Checklist item -->
        <Style Selector="Border.check-item">
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.check-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style Selector="Border.check-item.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Border.check-item.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <!-- Checklist title -->
        <Style Selector="TextBlock.check-title">
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.subtask-title">
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.subtask-inline">
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="(controls:TextBoxClearButton.Show)" Value="False"/>
        </Style>

        <Style Selector="TextBox.subtask-inline:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style Selector="TextBox.subtask-inline:focus">
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="ItemsControl.locked TextBox.subtask-inline,
                         ItemsControl.locked TextBox.subtask-inline:pointerover,
                         ItemsControl.locked TextBox.subtask-inline:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style Selector="Border.subtask-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="1,0"/>
        </Style>

        <Style Selector="Border.subtask-row.dragging">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style Selector="Border.subtask-grip">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="ItemsControl.locked Border.subtask-grip">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="TextBlock.subtask-grip-mark">
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="Button.subtask-remove">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.subtask-remove:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="ItemsControl.locked Button.subtask-remove">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Priority -->
        <Style Selector="TextBlock.priority">
            <Setter Property="FontSize" Value="{DynamicResource Font11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Border.priority-chip">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.priority-label">
            <Setter Property="FontSize" Value="{DynamicResource Font11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Border.priority-chip.critical">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceSoftBrush}"/>
        </Style>
        <Style Selector="Border.priority-chip.critical TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Border.priority-chip.required">
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
        </Style>
        <Style Selector="Border.priority-chip.required TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
        </Style>

        <Style Selector="Border.priority-chip.conditional">
            <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}"/>
        </Style>
        <Style Selector="Border.priority-chip.conditional TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
        </Style>

        <Style Selector="Border.priority-chip.review">
            <Setter Property="Background" Value="{DynamicResource ReviewSurfaceBrush}"/>
        </Style>
        <Style Selector="Border.priority-chip.review TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ReviewTextBrush}"/>
        </Style>

        <!-- Icon buttons -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="{DynamicResource IconButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource IconButtonSize}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ItemsControl.locked Button.icon">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <Style Selector="ItemsControl.locked CheckBox">
            <Setter Property="IsEnabled" Value="False"/>
        </Style>

        <Style Selector="Button.icon.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style Selector="Button.icon.density">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <Style Selector="Button.action:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style Selector="StackPanel.page-header.compact TextBox.page-title">
            <Setter Property="FontSize" Value="{DynamicResource Font18}"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="StackPanel.page-header.compact ProgressBar.progress">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="StackPanel.page-header.compact StackPanel.progress-block">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Spacing" Value="0"/>
        </Style>

        <Style Selector="Button.icon.delete:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Button.icon.move">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
        </Style>

        <Style Selector="ItemsControl:not(.reorder) Button.icon.move">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Completed -->
        <Style Selector="Border.check-item.completed">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <Style Selector="TextBlock.check-title.completed">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

<Style Selector="TextBlock.check-notes">
    <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
</Style>

        <Style Selector="Button.notes-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.notes-link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
        </Style>

        <Style Selector="Button.copied-from-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.copied-from-link TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="Button.copied-from-link:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
        </Style>

        <Style Selector="Button.notes-link.late">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Button.notes-link.late:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextHoverBrush}"/>
        </Style>

        <Style Selector="TextBlock.work-value">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style Selector="Button.work-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.work-link TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style Selector="Button.work-link:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style Selector="TextBlock.item-deadline.late">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Button.subtask-link">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.subtask-link:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}"/>
        </Style>

        <Style Selector="Button.subtask-link.done">
            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
        </Style>

        <Style Selector="Button.deadline-clear">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.deadline-clear:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBox.reminder-time">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="(controls:TextBoxClearButton.Show)" Value="False"/>
        </Style>

        <Style Selector="TextBox.reminder-time:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.reminder-choice">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-choice:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}"/>
        </Style>

        <Style Selector="Button.reminder-choice.on">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-mode">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-mode:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}"/>
        </Style>

        <Style Selector="Button.reminder-mode.on">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-mode /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-mode.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-cancel">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-cancel /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.reminder-set">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-set /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.reminder-set:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-set:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-cancel TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="Button.reminder-set TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reminder-cancel:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Calendar TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:inactive TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="CalendarDayButton:today:not(:selected) TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CalendarDayButton:selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBox.search">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.search:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="ComboBox.filter">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="TextBlock.filter-label">
            <Setter Property="FontSize" Value="{DynamicResource Font11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="TextBlock.view-count">
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style Selector="TextBlock.empty-filter">
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.empty-add">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="Button.empty-add:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
        </Style>

        <Style Selector="Button.empty-add:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Button.empty-add TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font92}"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <Style Selector="Button.empty-add:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
        </Style>

        <Style Selector="Button.empty-add:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

    </UserControl.Styles>


    <Grid Margin="{DynamicResource PageMargin}"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="{DynamicResource SectionSpacing}">

        <!-- HEADER -->
        <StackPanel x:Name="HeaderPanel"
                    Grid.Row="0"
                    Classes="page-header"
                    Spacing="6">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <TextBox x:Name="WorkflowTitleBox"
                         Classes="page-title"
                         PlaceholderText="Work title"
                         VerticalAlignment="Center"
                         LostFocus="Title_LostFocus"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                <Button x:Name="ExportButton"
                        Content="Export"
                        Classes="action secondary"
                        ToolTip.Tip="Export this checklist as a CSV file, or copy it as text">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                FlyoutPresenterClasses="app-popup">
                            <StackPanel Spacing="8"
                                        MinWidth="188">
                                <Button Content="Export as CSV…"
                                        Classes="action secondary"
                                        HorizontalAlignment="Stretch"
                                        Click="ExportCsv_Click"/>
                                <Button Content="Copy as text"
                                        Classes="action secondary"
                                        HorizontalAlignment="Stretch"
                                        Click="CopyText_Click"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Classes="progress-block"
                            Width="220"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="ProgressText"
                               Classes="progress-text"
                               HorizontalAlignment="Right"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Classes="progress"
                                 Minimum="0"
                                 Maximum="100"/>

                </StackPanel>

                </StackPanel>

            </Grid>

            <StackPanel x:Name="HeaderDetails">

            <StackPanel Orientation="Horizontal"
                        Spacing="0">
                <TextBlock x:Name="WorkflowDescription"
                           Classes="page-subtitle"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" · "
                           Classes="page-subtitle"
                           VerticalAlignment="Center"/>
                <Button x:Name="DeadlineButton"
                        Classes="notes-link"
                        Content="Pick deadline"
                        MinHeight="0"
                        FontSize="{DynamicResource Font13}"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterClasses="app-popup"
                                Opened="DeadlineFlyout_Opened">
                            <StackPanel Spacing="10"
                                        Width="294"
                                        KeyDown="DeadlineEditor_KeyDown">
                                <Calendar x:Name="DeadlineCalendar"
                                          SelectionMode="SingleDate"/>
                                <TextBlock Text="Time"
                                           Classes="meta-label"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBox x:Name="DeadlineHourBox"
                                             Classes="reminder-time"
                                             PlaceholderText="09"/>
                                    <TextBlock Text=":"
                                               FontSize="{DynamicResource Font16}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox x:Name="DeadlineMinuteBox"
                                             Classes="reminder-time"
                                             PlaceholderText="00"/>
                                    <Button x:Name="DeadlineAmButton"
                                            Classes="reminder-choice"
                                            Content="AM"
                                            Click="DeadlineMeridiem_Click"/>
                                    <Button x:Name="DeadlinePmButton"
                                            Classes="reminder-choice"
                                            Content="PM"
                                            Click="DeadlineMeridiem_Click"/>
                                </StackPanel>
                                <TextBlock Text="Notify"
                                           Classes="meta-label"/>
                                <Grid ColumnDefinitions="*,*,*"
                                      ColumnSpacing="8">
                                    <Button x:Name="DeadlineNotifyNoneButton"
                                            Classes="reminder-mode"
                                            Content="None"
                                            Click="DeadlineNotify_Click"/>
                                    <Button x:Name="DeadlineNotifyOnButton"
                                            Grid.Column="1"
                                            Classes="reminder-mode"
                                            Content="On time"
                                            Click="DeadlineNotify_Click"/>
                                    <Button x:Name="DeadlineNotifyBeforeButton"
                                            Grid.Column="2"
                                            Classes="reminder-mode"
                                            Content="Before"
                                            Click="DeadlineNotify_Click"/>
                                </Grid>
                                <StackPanel x:Name="DeadlineLeadPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            IsVisible="False">
                                    <TextBox x:Name="DeadlineLeadBox"
                                             Classes="reminder-time"
                                             Width="72"
                                             MaxLength="3"
                                             Text="30"/>
                                    <Button x:Name="DeadlineLeadMinutesButton"
                                            Classes="reminder-mode"
                                            Content="minutes"
                                            Click="DeadlineLeadUnit_Click"/>
                                    <Button x:Name="DeadlineLeadHoursButton"
                                            Classes="reminder-mode"
                                            Content="hours"
                                            Click="DeadlineLeadUnit_Click"/>
                                </StackPanel>
                                <Button x:Name="DeadlineSilentButton"
                                        Classes="reminder-mode"
                                        Content="Silent"
                                        HorizontalAlignment="Left"
                                        MinWidth="120"
                                        Click="DeadlineSilent_Click"/>
                                <TextBlock Text="No sound for this deadline"
                                           FontSize="{DynamicResource Font11}"
                                           Foreground="{DynamicResource TextSubtleBrush}"/>
                                <TextBlock x:Name="DeadlineError"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font12}"
                                           Foreground="{DynamicResource DangerTextBrush}"
                                           IsVisible="False"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="Cancel"
                                            Classes="reminder-cancel"
                                            Click="DeadlineCancel_Click"/>
                                    <Button Content="Set"
                                            Classes="reminder-set"
                                            Click="DeadlineSet_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ClearDeadlineButton"
                        Classes="deadline-clear"
                        Content="×"
                        Margin="4,0,0,0"
                        ToolTip.Tip="Clear deadline"
                        IsVisible="False"
                        Click="ClearDeadline_Click"/>
                <TextBlock Text=" · "
                           Classes="page-subtitle"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
                <Button x:Name="ReminderButton"
                        Classes="notes-link"
                        Content="Set reminder"
                        MinHeight="0"
                        FontSize="{DynamicResource Font13}"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterClasses="app-popup"
                                Opened="ReminderFlyout_Opened">
                            <StackPanel Spacing="10"
                                        Width="294"
                                        KeyDown="ReminderEditor_KeyDown">
                                <TextBlock Text="Repeat"
                                           Classes="meta-label"/>
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <Button x:Name="ReminderOnceButton"
                                            Classes="reminder-mode"
                                            Content="One time"
                                            Click="ReminderMode_Click"/>
                                    <Button x:Name="ReminderRepeatButton"
                                            Grid.Column="1"
                                            Classes="reminder-mode"
                                            Content="Occurrence"
                                            Click="ReminderMode_Click"/>
                                </Grid>
                                <StackPanel x:Name="ReminderOncePanel"
                                            Spacing="10">
                                    <Calendar x:Name="ReminderCalendar"
                                              SelectionMode="SingleDate"/>
                                    <TextBlock Text="Time"
                                               Classes="meta-label"/>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBox x:Name="ReminderHourBox"
                                                 Classes="reminder-time"
                                                 PlaceholderText="09"/>
                                        <TextBlock Text=":"
                                                   FontSize="{DynamicResource Font16}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBox x:Name="ReminderMinuteBox"
                                                 Classes="reminder-time"
                                                 PlaceholderText="00"/>
                                        <Button x:Name="ReminderAmButton"
                                                Classes="reminder-choice"
                                                Content="AM"
                                                Click="ReminderMeridiem_Click"/>
                                        <Button x:Name="ReminderPmButton"
                                                Classes="reminder-choice"
                                                Content="PM"
                                                Click="ReminderMeridiem_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="1–12 with AM/PM, or 00–23"
                                               FontSize="{DynamicResource Font11}"
                                               Foreground="{DynamicResource TextSubtleBrush}"/>
                                </StackPanel>
                                <StackPanel x:Name="ReminderIntervalPanel"
                                            Spacing="8"
                                            IsVisible="False">
                                    <TextBlock Text="Every"
                                               Classes="meta-label"/>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBox x:Name="ReminderIntervalBox"
                                                 Classes="meta reminder-count"
                                                 Width="72"
                                                 MaxLength="3"
                                                 Text="1"
                                                 HorizontalContentAlignment="Center"/>
                                        <ComboBox x:Name="ReminderIntervalUnit"
                                                  Classes="filter"
                                                  Width="140"
                                                  SelectedIndex="1">
                                            <ComboBoxItem Content="minutes"/>
                                            <ComboBoxItem Content="hours"/>
                                            <ComboBoxItem Content="days"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="ReminderSilentButton"
                                        Classes="reminder-mode"
                                        Content="Silent"
                                        HorizontalAlignment="Left"
                                        MinWidth="120"
                                        Click="ReminderSilent_Click"/>
                                <TextBlock Text="No sound for this reminder"
                                           FontSize="{DynamicResource Font11}"
                                           Foreground="{DynamicResource TextSubtleBrush}"/>
                                <TextBlock x:Name="ReminderError"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font12}"
                                           Foreground="{DynamicResource DangerTextBrush}"
                                           IsVisible="False"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="Cancel"
                                            Classes="reminder-cancel"
                                            Click="ReminderCancel_Click"/>
                                    <Button Content="Set"
                                            Classes="reminder-set"
                                            Click="ReminderSet_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ClearReminderButton"
                        Classes="deadline-clear"
                        Content="×"
                        Margin="4,0,0,0"
                        ToolTip.Tip="Clear reminder"
                        IsVisible="False"
                        Click="ClearReminder_Click"/>
            </StackPanel>

            <Button x:Name="AddDetailsButton"
                    Content="Add branch and PR"
                    Classes="notes-link"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    IsVisible="False"
                    Click="AddDetails_Click"/>

            <Grid x:Name="DetailsPanel"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  Margin="0,10,0,0"
                  IsVisible="False">

                <StackPanel Spacing="2">
                    <Grid x:Name="BranchLine"
                          ColumnDefinitions="Auto,*"
                          IsVisible="False">
                        <TextBlock Text="Branch -"
                                   Classes="page-subtitle"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BranchValue"
                                   Grid.Column="1"
                                   Classes="work-value"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="PullRequestLine"
                          ColumnDefinitions="Auto,*"
                          IsVisible="False">
                        <TextBlock Text="PR -"
                                   Classes="page-subtitle"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="PullRequestLink"
                                Grid.Column="1"
                                Classes="work-link"
                                Margin="6,0,0,0"
                                Click="OpenPullRequest_Click">
                            <TextBlock x:Name="PullRequestLinkText"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <Button x:Name="EditDetailsButton"
                        Grid.Column="1"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Edit"
                        Click="EditDetails_Click">
                    <Viewbox Width="15"
                             Height="15">
                        <Path Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="M12,20 H21 M16.5,3.5 A2.12,2.12 0 0 1 19.5,6.5 L7,19 L3,20 L4,16 Z M15,5 L19,9"/>
                    </Viewbox>
                </Button>

            </Grid>

            </StackPanel>

        </StackPanel>


        <!-- ACTION BAR -->
<Grid Grid.Row="1"
      ColumnDefinitions="*,Auto">

    <StackPanel Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
        <Button x:Name="AddCheckButton"
                Content="+  Add Check"
                Classes="action secondary"
                Click="AddCheck_Click"/>

        <Button x:Name="SaveButton"
                Content="Save"
                Classes="action secondary keep-alive"
                Click="Save_Click"/>

        <Button x:Name="SaveAsTemplateButton"
                Content="Save as template"
                Classes="action secondary"
                Click="SaveAsTemplate_Click"/>

        <Button x:Name="CopyButton"
                Content="Copy"
                Classes="action secondary"
                ToolTip.Tip="Choose checks to copy to another open checklist, or save them as a new file"
                Click="Copy_Click"/>

        <Button x:Name="DeleteChecksButton"
                Content="Delete"
                Classes="action secondary"
                ToolTip.Tip="Choose checks to remove together"
                Click="DeleteChecks_Click"/>

        <Button x:Name="RearrangeButton"
                Content="Rearrange"
                Classes="action secondary"
                Click="Rearrange_Click"/>

        <Button x:Name="FilterToggleButton"
                Content="Hide filters"
                Classes="action secondary"
                Click="FilterToggle_Click"/>
    </StackPanel>

    <Button x:Name="CompleteButton"
            Grid.Column="1"
            Content="✓  Complete"
            Classes="action primary complete-toggle"
            Click="Complete_Click"/>

</Grid>


        <!-- CHECKLIST -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">

            <Grid>
            <Grid x:Name="ChecklistBody"
                  RowDefinitions="Auto,*"
                  RowSpacing="14">

                <Grid x:Name="FiltersPanel"
                      Grid.Row="0"
                      ColumnDefinitions="*,130,150,150,Auto,Auto"
                      ColumnSpacing="8">

                    <TextBox x:Name="SearchTextBox"
                             Classes="search"
                             PlaceholderText="Search checklist"
                             VerticalAlignment="Bottom"
                             TextChanged="Search_TextChanged"/>

                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock Text="Status"
                                   Classes="filter-label"/>
                        <ComboBox x:Name="StatusFilterBox"
                                  Classes="filter"
                                  SelectionChanged="View_Changed">
                            <ComboBoxItem Content="Any status"/>
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="Completed"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Spacing="4">
                        <TextBlock Text="Priority"
                                   Classes="filter-label"/>
                        <ComboBox x:Name="PriorityFilterBox"
                                  Classes="filter"
                                  SelectionChanged="View_Changed">
                            <ComboBoxItem Content="Any priority"/>
                            <ComboBoxItem Content="Critical" Foreground="{DynamicResource DangerTextBrush}"/>
                            <ComboBoxItem Content="Required" Foreground="{DynamicResource WarningTextBrush}"/>
                            <ComboBoxItem Content="Conditional" Foreground="{DynamicResource InfoTextBrush}"/>
                            <ComboBoxItem Content="Review" Foreground="{DynamicResource ReviewTextBrush}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Spacing="4">
                        <TextBlock Text="Sort by"
                                   Classes="filter-label"/>
                        <ComboBox x:Name="SortBox"
                                  Classes="filter"
                                  SelectionChanged="View_Changed">
                            <ComboBoxItem Content="Checklist order"/>
                            <ComboBoxItem Content="Priority"/>
                            <ComboBoxItem Content="Category"/>
                            <ComboBoxItem Content="Title"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="ResetViewButton"
                            Grid.Column="4"
                            Content="Reset"
                            Classes="action secondary"
                            Height="{DynamicResource ControlHeightSm}"
                            Padding="12,0"
                            VerticalAlignment="Bottom"
                            Click="ResetView_Click"/>

                    <Border Grid.Column="5"
                            Height="{DynamicResource ControlHeightSm}"
                            VerticalAlignment="Bottom">
                        <TextBlock x:Name="ViewCountText"
                                   Classes="view-count"
                                   IsVisible="False"/>
                    </Border>

                </Grid>

            <Grid Grid.Row="1">

            <ScrollViewer x:Name="ChecklistScroll"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="ChecklistItems">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="models:ChecklistItem">

                            <Border Classes="check-item"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10"
                                    Loaded="CheckItem_Loaded">

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                      ColumnSpacing="12">

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted}"
                                              Click="CheckBox_Click"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              ToolTip.Tip="Toggle completion (Space)"/>


                                    <!-- Title + Priority -->
                                    <StackPanel Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="4">

    <TextBlock Text="{Binding Title}"
               Classes="check-title"/>

    <StackPanel Orientation="Horizontal"
                Spacing="6">
        <TextBlock Text="{Binding Category}"
                   Classes="priority"
                   VerticalAlignment="Center"
                   Loaded="CategoryMeta_Loaded"/>
        <TextBlock Text="·"
                   Classes="priority"
                   VerticalAlignment="Center"
                   Loaded="CategoryMeta_Loaded"/>
        <Border Classes="priority-chip"
                Loaded="PriorityChip_Loaded">
            <TextBlock Text="{Binding Priority}"
                       Classes="priority-label"/>
        </Border>
        <TextBlock Text="·"
                   Classes="priority"
                   VerticalAlignment="Center"
                   Loaded="DeadlineSeparator_Loaded"/>
        <TextBlock Classes="priority item-deadline"
                   VerticalAlignment="Center"
                   Loaded="ItemDeadline_Loaded"/>
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="4"
          IsVisible="{Binding HasCopiedFrom}">
        <TextBlock Grid.Column="0"
                   Text="Copied from"
                   Classes="priority"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Classes="copied-from-link"
                IsVisible="{Binding CanOpenCopiedFrom}"
                ToolTip.Tip="Open this file"
                Click="OpenCopiedFrom_Click">
            <TextBlock Text="{Binding CopiedFrom}"
                       TextWrapping="Wrap"/>
        </Button>
        <TextBlock Grid.Column="1"
                   Text="{Binding CopiedFrom}"
                   Classes="priority"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   IsVisible="{Binding CopiedFromIsPlain}"/>
    </Grid>

<StackPanel Spacing="6"
            IsVisible="{Binding HasNotes}">

    <controls:NoteText Source="{Binding Notes}"
                       Classes="check-notes"
                       MaxHeight="72"/>

    <Button Content="View notes"
            Classes="notes-link"
            Tag="{Binding}"
            Click="ViewNotes_Click"/>

</StackPanel>

<StackPanel Spacing="6"
            IsVisible="{Binding HasEvidence}">
    <TextBlock Text="Evidence"
               Classes="priority"/>
    <controls:EvidenceGallery Files="{Binding Evidence}"
                              Compact="True"/>
</StackPanel>

<ItemsControl ItemsSource="{Binding LinkedSubtasks}"
              Margin="0,8,0,0"
              IsVisible="{Binding HasLinks}">
    <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="models:ChecklistSubtask">
            <Button Classes="subtask-link"
                    Content="{Binding LinkLabel}"
                    Margin="0,0,0,4"
                    Click="OpenLinkedSubtask_Click"
                    Loaded="LinkedSubtask_Loaded"/>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>

<StackPanel Classes="manual-subtasks"
            Margin="0,4,0,0"
            IsVisible="False"
            Loaded="ManualSubtasks_Loaded"/>

</StackPanel>


                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Top">
                                        <Button Classes="icon move"
                                                Content="↑"
                                                ToolTip.Tip="Move up"
                                                Tag="{Binding}"
                                                IsVisible="False"
                                                Click="MoveUp_Click"/>
                                        <Button Classes="icon move"
                                                Content="↓"
                                                ToolTip.Tip="Move down"
                                                Tag="{Binding}"
                                                IsVisible="False"
                                                Click="MoveDown_Click"/>
                                    </StackPanel>

                                    <!-- Edit -->
                                    <Button Grid.Column="3"
                                            Classes="icon"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="Edit (F2)"
                                            Tag="{Binding}"
                                            Click="EditCheck_Click">
                                        <Viewbox Width="15"
                                                 Height="15">
                                            <Path Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Data="M12,20 H21 M16.5,3.5 A2.12,2.12 0 0 1 19.5,6.5 L7,19 L3,20 L4,16 Z M15,5 L19,9"/>
                                        </Viewbox>
                                    </Button>


                                    <!-- Delete -->
                                    <Button Grid.Column="4"
                                            Classes="icon delete"
                                            VerticalAlignment="Top"
                                            Content="🗑"
                                            ToolTip.Tip="Remove"
                                            Tag="{Binding}"
                                            Click="RemoveCheck_Click"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <Button x:Name="EmptyAddButton"
                    Classes="empty-add"
                    IsVisible="False"
                    Click="AddCheck_Click">
                <TextBlock Text="+"/>
            </Button>

            <TextBlock x:Name="EmptyFilterText"
                       Classes="empty-filter"
                       Text="No checks match."
                       IsVisible="False"/>

            </Grid>

            </Grid>

            <TextBlock x:Name="CollapsedCountText"
                       Classes="view-count"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       IsVisible="False"/>

            </Grid>

        </Border>

        <Border x:Name="DetailPane"
                Grid.Column="1"
                Width="400"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                IsVisible="False">

            <views:CheckDetailView x:Name="SideDetail"/>

        </Border>

        </Grid>

    </Grid>

</UserControl>