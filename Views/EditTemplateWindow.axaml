<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SuperDev.Views.EditTemplateWindow"
        Width="680"
        Height="720"
        MinWidth="560"
        MinHeight="520"
        CanResize="True"
        Title="Edit template"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.check-field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Button.icon-choice">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font18}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.icon-choice /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.icon-choice:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style Selector="Button.icon-choice.on">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

        <Style Selector="Button.form-button">
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.form-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.cancel:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        </Style>

        <Style Selector="Button.delete">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style Selector="Button.delete:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
        </Style>

        <Style Selector="Button.add-check">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.remove-check">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightXs}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.remove-check:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </Style>

        <Style Selector="Border.check-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style Selector="Border.check-row.dragging">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style Selector="Border.check-grip">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="TextBlock.check-grip-mark">
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Title"
                       FontSize="{DynamicResource Font13}"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox x:Name="TitleBox"
                     Classes="field"
                     PlaceholderText="Template name"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="8">
            <TextBlock Text="Icon"
                       FontSize="{DynamicResource Font13}"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6">
                <ScrollViewer MaxHeight="140"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="IconList"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="Checks"
                           FontSize="{DynamicResource Font13}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Drag to reorder"
                           FontSize="{DynamicResource Font12}"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="add-check"
                    Content="Add check"
                    Click="AddCheck_Click"/>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <ScrollViewer x:Name="ChecksScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChecksList" Spacing="8"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Button x:Name="DeleteButton"
                    Grid.Column="0"
                    Classes="form-button delete"
                    Content="Delete"
                    Click="Delete_Click"/>
            <Button Grid.Column="2"
                    Classes="form-button cancel"
                    Content="Cancel"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="SaveAsNewButton"
                    Grid.Column="3"
                    Classes="form-button secondary"
                    Content="Save as new"
                    Margin="0,0,8,0"
                    Click="SaveAsNew_Click"/>
            <Button x:Name="SaveButton"
                    Grid.Column="4"
                    Classes="form-button primary"
                    Content="Save"
                    IsDefault="True"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
