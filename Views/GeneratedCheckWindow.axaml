<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SuperDev.Views.GeneratedCheckWindow"
        Width="520"
        Height="760"
        MinWidth="440"
        MinHeight="480"
        CanResize="True"
        Title="Generated check"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="CheckBox.choose">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightLg}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="TextBox.notes">
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>

        <Style Selector="TextBox.notes:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="Height" Value="{DynamicResource ControlHeightLg}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Button.form-button">
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.cancel:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.save">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.save:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.save:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Generated check"
                       FontSize="{DynamicResource Font22}"
                       FontWeight="SemiBold"/>
            <TextBlock Classes="hint"
                       Text="Checked parts are copied into this check. Uncheck anything you want to leave out."/>
            <TextBlock x:Name="NoticeText"
                       Classes="hint"
                       IsVisible="False"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,0,8,0">
                <StackPanel Spacing="6">
                    <CheckBox x:Name="UseTitleBox"
                              Classes="choose"
                              Content="Title"
                              IsChecked="True"
                              IsCheckedChanged="Selection_Changed"/>
                    <TextBox x:Name="TitleBox" Classes="field"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <CheckBox x:Name="UseCategoryBox"
                                  Classes="choose"
                                  Content="Category"
                                  IsChecked="True"
                                  IsCheckedChanged="Selection_Changed"/>
                        <ComboBox x:Name="CategoryBox" Classes="field"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <CheckBox x:Name="UsePriorityBox"
                                  Classes="choose"
                                  Content="Priority"
                                  IsChecked="True"
                                  IsCheckedChanged="Selection_Changed"/>
                        <ComboBox x:Name="PriorityBox"
                                  Classes="field"
                                  SelectionChanged="PriorityBox_SelectionChanged"/>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="6">
                    <CheckBox x:Name="UseTypeBox"
                              Classes="choose"
                              Content="Type"
                              IsChecked="True"
                              IsCheckedChanged="Selection_Changed"/>
                    <ComboBox x:Name="TypeBox" Classes="field"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <CheckBox x:Name="UseNotesBox"
                              Classes="choose"
                              Content="Notes"
                              IsChecked="True"
                              IsCheckedChanged="Selection_Changed"/>
                    <TextBox x:Name="NotesBox" Classes="notes"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <CheckBox x:Name="UseAcceptanceBox"
                              Classes="choose"
                              Content="Acceptance"
                              IsChecked="True"
                              IsCheckedChanged="Selection_Changed"/>
                    <TextBox x:Name="AcceptanceBox"
                             Classes="notes"
                             PlaceholderText="How you know this check is done"/>
                </StackPanel>
                <StackPanel x:Name="ReferenceEditors" Spacing="14"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="Subtasks"
                               FontSize="{DynamicResource Font13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBodyBrush}"/>
                    <TextBlock x:Name="EmptySubtasks"
                               Classes="hint"
                               Text="No subtasks were generated."
                               IsVisible="False"/>
                    <StackPanel x:Name="SubtaskList" Spacing="8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Omit"
                    Classes="form-button cancel"
                    Click="Omit_Click"/>
            <Button x:Name="UseButton"
                    Content="Use selected"
                    Classes="form-button save"
                    IsDefault="True"
                    Click="Use_Click"/>
        </StackPanel>
    </Grid>
</Window>
