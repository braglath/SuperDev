<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SuperDev.Views.MainWindow"
        Width="1000"
        Height="850"
        MinWidth="800"
        MinHeight="700"
        Title="Super Dev"
        Background="{DynamicResource AppBackgroundBrush}">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="New Checklist"
                                    Click="NewChecklistMenu_Click"/>
                    <NativeMenuItem Header="Open…"
                                    Click="OpenMenu_Click"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Save"
                                    Click="SaveMenu_Click"/>
                    <NativeMenuItem Header="Save As…"
                                    Click="SaveAsMenu_Click"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Export as CSV…"
                                    IsEnabled="False"
                                    Click="ExportCsvMenu_Click"/>
                    <NativeMenuItem Header="Copy as Text"
                                    IsEnabled="False"
                                    Click="CopyTextMenu_Click"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Options">
                <NativeMenu>
                    <NativeMenuItem Header="Settings"
                                    Click="SettingsMenu_Click"/>
                    <NativeMenuItem Header="Reminders"
                                    Click="RemindersMenu_Click"/>
                    <NativeMenuItem Header="Add Check"
                                    IsEnabled="False"
                                    Click="AddCheckMenu_Click"/>
                    <NativeMenuItem Header="Save as template"
                                    IsEnabled="False"
                                    Click="SaveAsTemplateMenu_Click"/>
                    <NativeMenuItem Header="Rearrange…"
                                    IsEnabled="False"
                                    Click="RearrangeMenu_Click"/>
                    <NativeMenuItem Header="Copy to…"
                                    IsEnabled="False"
                                    Click="CopyMenu_Click"/>
                    <NativeMenuItem Header="Delete…"
                                    IsEnabled="False"
                                    Click="DeleteChecksMenu_Click"/>
                    <NativeMenuItem Header="Pin Tab"
                                    IsEnabled="False"
                                    Click="PinTabMenu_Click"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Help">
                <NativeMenu>
                    <NativeMenuItem Header="Check for Updates…"
                                    Click="CheckForUpdatesMenu_Click"/>
                    <NativeMenuItem Header="Keyboard Shortcuts"
                                    Click="KeyboardShortcutsMenu_Click"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>

        <!-- ========================================================= -->
        <!-- GLOBAL                                                     -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- The title panel's visibility is bound in the template, so hide the text itself. -->
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
<Style Selector="Border.workspace-tab">
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="MaxWidth" Value="190"/>
    <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
</Style>

<Style Selector="Border.workspace-tab.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Border.workspace-tab.dragging">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="ZIndex" Value="2"/>
</Style>

<!-- The tab scroller reserves a row for its bar so it does not cover the tabs.
     These styles keep that bar as a thin thumb, without the arrow buttons. -->
<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar">
    <Setter Property="AllowAutoHide" Value="True"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineUpButton,
                 ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Width" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
    <Setter Property="Height" Value="3"/>
    <Setter Property="MinHeight" Value="3"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Background" Value="{DynamicResource TextSubtleBrush}"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ RepeatButton">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Thumb">
    <Setter Property="Height" Value="3"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
</Style>

<Style Selector="Button.tab-close">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.tab-close:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
</Style>

<Style Selector="Button.tab-pin">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<Style Selector="Button.tab-pin /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.tab-pin Shape">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Fill" Value="Transparent"/>
</Style>

<Style Selector="Button.tab-pin:pointerover">
    <Setter Property="Background" Value="{DynamicResource TextFaintBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
</Style>

<Style Selector="Button.tab-pin Viewbox.pin-on">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="Button.tab-pin.pinned">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextHoverBrush}"/>
</Style>

<Style Selector="Button.tab-pin.pinned Viewbox.pin-off">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="Button.tab-pin.pinned Viewbox.pin-on">
    <Setter Property="IsVisible" Value="True"/>
</Style>

<Style Selector="Button.tab-pin.pinned Shape">
    <Setter Property="Stroke" Value="{DynamicResource TextOnAccentBrush}"/>
    <Setter Property="Fill" Value="{DynamicResource TextOnAccentBrush}"/>
</Style>

<Style Selector="Button.tab-pin.pinned:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccentBrush}"/>
</Style>

<Style Selector="Button.settings-back">
    <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.settings-back:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Button.settings-back:disabled">
    <Setter Property="Opacity" Value="0.5"/>
</Style>

<Style Selector="Button.settings-primary">
    <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.settings-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Button.settings-primary:disabled">
    <Setter Property="Opacity" Value="0.5"/>
</Style>

<Style Selector="TextBlock.settings-section">
    <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="4,8,0,0"/>
</Style>

<Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="ClipToBounds" Value="False"/>
</Style>

<Style Selector="Border.settings-icon">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
</Style>

<Style Selector="Button.appearance-choice">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<Style Selector="Button.appearance-choice.theme-card">
    <Setter Property="MinHeight" Value="128"/>
</Style>

<Style Selector="Button.appearance-choice.option-card">
    <Setter Property="MinHeight" Value="76"/>
</Style>

<Style Selector="Button.appearance-choice:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Button.appearance-choice.on">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
</Style>

<Style Selector="Button.appearance-choice.on:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
</Style>

<Style Selector="Button.appearance-choice TextBlock.choice-title">
    <Setter Property="FontSize" Value="{DynamicResource Font15}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
</Style>

<Style Selector="Button.appearance-choice TextBlock.choice-hint">
    <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
</Style>

<Style Selector="Button.appearance-choice Path.choice-icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
</Style>

<Style Selector="Button.appearance-choice.on Path.choice-icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}"/>
</Style>

<Style Selector="Button.appearance-choice Path.choice-fill">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
</Style>

<Style Selector="Button.appearance-choice.on Path.choice-fill">
    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
</Style>

<Style Selector="Button.appearance-choice TextBlock.aa">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

<Style Selector="Button.appearance-choice.on TextBlock.aa">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
</Style>

<Style Selector="Button.accent-swatch">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<Style Selector="Button.accent-swatch:pointerover">
    <Setter Property="BorderThickness" Value="2"/>
</Style>

<Style Selector="Button.accent-swatch.on">
    <Setter Property="BorderThickness" Value="3"/>
</Style>

<Style Selector="Menu.title-menu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
</Style>

<Style Selector="Menu.title-menu > MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

<Style Selector="Menu.title-menu > MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
</Style>

<Style Selector="Menu.title-menu MenuItem">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
    <Setter Property="Padding" Value="12,8"/>
</Style>

<Style Selector="Menu.title-menu MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
</Style>

<Style Selector="Menu.title-menu MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
</Style>

<Style Selector="Button.new-tab">
<Setter Property="Width" Value="36"/>
<Setter Property="MinWidth" Value="36"/>
<Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="CornerRadius" Value="18"/>
<Setter Property="HorizontalContentAlignment" Value="Center"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="{DynamicResource Font22}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

        <!-- ========================================================= -->
        <!-- WORK TITLE INPUT                                           -->
        <!-- ========================================================= -->

<Style Selector="TextBox.work-title">
    <Setter Property="Height" Value="{DynamicResource ControlHeightXl}"/>
    <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSubtleBrush}"/>
</Style>

<Style Selector="TextBox.work-title:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Button.recent">
    <Setter Property="Height" Value="56"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,8"/>
</Style>

<Style Selector="Button.recent:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Button.recent:pressed">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
</Style>

<Style Selector="Button.recent.open">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
</Style>

<Style Selector="Button.recent.open:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
</Style>

<Style Selector="Button.recent.open:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
</Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE CARD                                              -->
        <!-- ========================================================= -->

        <Style Selector="Button.template">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font14}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
    </Style>

        <!-- Hover -->
        <Style Selector="Button.template:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Pressed -->
        <Style Selector="Button.template:pressed">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>

        <!-- Selected -->
        <Style Selector="Button.template.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.template-edit">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,6,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ZIndex" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.template-edit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.template-edit:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.template-title">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="120"/>
            <Setter Property="MaxHeight" Value="36"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE ICON                                              -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock.template-icon">
            <Setter Property="FontSize" Value="{DynamicResource Font22}"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>


        <!-- ========================================================= -->
        <!-- CREATE BUTTON                                               -->
        <!-- ========================================================= -->

<Style Selector="Button.create">
    <Setter Property="MinWidth" Value="150"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Padding" Value="28,10"/>
    <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>

    <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

    <Setter Property="VerticalContentAlignment"
            Value="Center"/>
</Style>

        <Style Selector="Button.create:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.create:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        </Style>

        <Style Selector="Button.create.open">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.create.open:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.create.open:pressed">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>

        <Style Selector="Button.bell">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeightXs}"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.bell /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.bell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>

        <Style Selector="Button.bell:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        </Style>

        <Style Selector="Button.bell Path">
            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Button.bell.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

        <Style Selector="Button.bell.selected Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style Selector="Button.bell:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.bell.due Path">
            <Setter Property="Stroke" Value="{DynamicResource WarningTextBrush}"/>
        </Style>

        <Style Selector="FlyoutPresenter.notify-popup">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="Button.notify-row /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style Selector="Button.notify-dismiss">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font16}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-dismiss /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-dismiss:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.notify-clear-all">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-clear-all /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-clear-all:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
        </Style>

        <Style Selector="TextBlock.notify-title">
            <Setter Property="FontSize" Value="{DynamicResource Font13}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="TextBlock.notify-meta">
            <Setter Property="FontSize" Value="{DynamicResource Font12}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Window.Styles>


    <!-- ============================================================= -->
    <!-- MAIN CONTENT                                                  -->
    <!-- ============================================================= -->

    <Grid RowDefinitions="Auto,Auto,*">

    <Border x:Name="TitleChrome"
            Grid.Row="0"
            Height="{DynamicResource ControlHeight}"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0">
        <Grid ColumnDefinitions="Auto,Auto,*">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Image Width="18"
                       Height="18"
                       Source="avares://Super Dev/Assets/app.ico"/>
                <TextBlock x:Name="AppNameText"
                           Text="Super Dev"
                           FontSize="{DynamicResource Font14}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Margin="0,0,4,0">
            <Button x:Name="RemindersButton"
                    Classes="bell"
                    ToolTip.Tip="Reminders"
                    Click="RemindersButton_Click">
                <Panel Width="32" Height="{DynamicResource ControlHeightXs}">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Path Width="16"
                              Height="16"
                              Stretch="Uniform"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent"
                              Data="M8,1.5 A6.5,6.5 0 1 0 8,14.5 A6.5,6.5 0 1 0 8,1.5 M8,4.5 V8.2 L10.6,9.8"/>
                    </Viewbox>
                </Panel>
            </Button>
            <Button x:Name="ReminderBell"
                    Classes="bell"
                    ToolTip.Tip="Notifications">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight"
                            FlyoutPresenterClasses="notify-popup"
                            Opened="ReminderBell_Opened"
                            Closed="ReminderBell_Closed">
                        <DockPanel Width="300">
                            <Grid DockPanel.Dock="Top"
                                  ColumnDefinitions="*,Auto"
                                  Margin="8,4,4,6">
                                <TextBlock Text="Notifications"
                                           FontSize="{DynamicResource Font13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ClearAllNotificationsButton"
                                        Grid.Column="1"
                                        Classes="notify-clear-all"
                                        Content="Clear all"
                                        IsVisible="False"
                                        Click="ClearAllNotifications_Click"/>
                            </Grid>
                            <ScrollViewer MaxHeight="268"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ReminderList" Spacing="2"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Flyout>
                </Button.Flyout>
                <Panel Width="32" Height="{DynamicResource ControlHeightXs}">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Path Width="16"
                              Height="17"
                              Stretch="Uniform"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent"
                              Data="M8,17 A2,2 0 0 0 10,15 H6 A2,2 0 0 0 8,17 M14,11 V6 A6,6 0 1 0 2,6 V11 L0,13 H16 Z"/>
                    </Viewbox>
                    <Ellipse x:Name="ReminderBadge"
                             Width="7"
                             Height="7"
                             Fill="{DynamicResource DangerTextBrush}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,5,5,0"
                             IsVisible="False"
                             IsHitTestVisible="False"/>
                </Panel>
            </Button>
            </StackPanel>
            <Menu x:Name="WindowMenu"
                  Grid.Column="1"
                  Classes="title-menu"
                  IsVisible="False"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0">
                <MenuItem Header="File">
                    <MenuItem Header="New Checklist"/>
                    <MenuItem Header="Open…"/>
                    <Separator/>
                    <MenuItem x:Name="WindowSaveMenuItem"
                              Header="Save"/>
                    <MenuItem Header="Save As…"/>
                    <Separator/>
                    <MenuItem x:Name="WindowExportCsvMenuItem"
                              Header="Export as CSV…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowCopyTextMenuItem"
                              Header="Copy as Text"
                              IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Options">
                    <MenuItem Header="Settings"/>
                    <MenuItem Header="Reminders"/>
                    <MenuItem x:Name="WindowAddCheckMenuItem"
                              Header="Add Check"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowSaveTemplateMenuItem"
                              Header="Save as template"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowRearrangeMenuItem"
                              Header="Rearrange…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowCopyMenuItem"
                              Header="Copy to…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowDeleteMenuItem"
                              Header="Delete…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowPinMenuItem"
                              Header="Pin Tab"
                              IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Check for Updates…"/>
                    <MenuItem Header="Keyboard Shortcuts"/>
                </MenuItem>
            </Menu>
        </Grid>
    </Border>

    <!-- Tab bar -->
    <Border x:Name="TabBar"
        Grid.Row="1"
        Background="{DynamicResource AppBackgroundBrush}"
        Padding="12,8"
        BorderBrush="{DynamicResource BorderSoftBrush}"
        BorderThickness="0,0,0,1"
        IsVisible="False">

    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12">

        <ScrollViewer x:Name="TabsScrollViewer"
                      Classes="tabs"
                      Grid.Column="0"
                      ClipToBounds="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">

            <StackPanel x:Name="TabsPanel"
                        Orientation="Horizontal"
                        Spacing="8"/>
        </ScrollViewer>

        <Button x:Name="NewTabButton"
                Grid.Column="1"
                Classes="new-tab"
                ToolTip.Tip="New checklist"
                Click="NewTab_Click">
            <Grid Width="14" Height="14">
                <Rectangle Width="14"
                           Height="2"
                           Fill="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Rectangle Width="2"
                           Height="14"
                           Fill="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Button>

    </Grid>
</Border>

    <!-- Active checklist view -->
    <ContentControl x:Name="WorkspaceContent"
                    Grid.Row="2"
                    IsVisible="False"/>

    <!-- Your existing template-selection screen -->
    <ScrollViewer x:Name="HomePanel"
                  Grid.Row="2"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Margin="50">

        <!-- ========================================================= -->
        <!-- HEADER                                                      -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,20,0,45">

            <TextBlock Text="Super Dev"
                       FontSize="{DynamicResource Font38}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Text="Developer Checklist Assistant"
                       FontSize="{DynamicResource Font17}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- RECENT CHECKLISTS                                           -->
        <!-- ========================================================= -->

        <StackPanel x:Name="RecentSection"
                    Grid.Row="1"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,0,0,32"
                    IsVisible="False">

            <TextBlock Text="Recent checklists"
                       FontSize="{DynamicResource Font14}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBodyBrush}"/>

            <Grid x:Name="RecentItems"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- WORK TITLE                                                  -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="2"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="9"
                    Margin="0,0,0,35">

            <TextBlock Text="Work title"
                       FontSize="{DynamicResource Font14}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBodyBrush}"/>

            <TextBox x:Name="WorkTitleTextBox"
                     Classes="work-title"
                     Watermark="What are you working on?"
                     WatermarkForeground="{DynamicResource TextSubtleBrush}"/>

            <TextBlock Text="Branch name"
                       FontSize="{DynamicResource Font14}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBodyBrush}"
                       Margin="0,8,0,0"/>

            <TextBox x:Name="BranchNameTextBox"
                     Classes="work-title"
                     PlaceholderText="feature/my-change"/>

            <TextBlock Text="PR link"
                       FontSize="{DynamicResource Font14}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBodyBrush}"
                       Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <TextBox x:Name="PullRequestTextBox"
                         Classes="work-title"
                         PlaceholderText="https://github.com/.../pull/1"
                         TextChanged="PullRequest_TextChanged"/>

                <Button x:Name="OpenPullRequestButton"
                        Grid.Column="1"
                        Content="Open"
                        Classes="create open"
                        Height="{DynamicResource ControlHeightXl}"
                        MinWidth="88"
                        Padding="16,0"
                        IsEnabled="False"
                        Click="OpenPullRequest_Click"/>

            </Grid>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATE LABEL                                              -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="3"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="5"
                    Margin="0,0,0,20">

            <TextBlock Text="Choose a workflow"
                       FontSize="{DynamicResource Font14}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBodyBrush}"/>

            <TextBlock Text="Select the workflow that best matches your work"
                       FontSize="{DynamicResource Font13}"
                       Foreground="{DynamicResource TextSubtleBrush}"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATES + CREATE                                          -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center"
                    Spacing="36">

            <!-- TEMPLATE CARDS -->

            <WrapPanel x:Name="TemplateList"
                       HorizontalAlignment="Center"
                       Orientation="Horizontal"/>


            <!-- CREATE -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">

                <Button x:Name="OpenChecklistButton"
                        Classes="create open"
                        Content="Open Checklist"
                        Click="Open_Click"/>

                <Button x:Name="CreateButton"
                        Classes="create"
                        Content="Create Checklist"
                        Click="Create_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>
    </ScrollViewer>

    <ScrollViewer x:Name="RemindersPanel"
                  Grid.Row="2"
                  IsVisible="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760"
                    Margin="24,28,24,40"
                    HorizontalAlignment="Stretch"
                    Spacing="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <TextBlock Text="Reminders"
                           FontSize="{DynamicResource Font28}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="bell"
                        ToolTip.Tip="Close"
                        VerticalAlignment="Center"
                        Click="CloseReminders_Click">
                    <Panel Width="32" Height="{DynamicResource ControlHeightXs}">
                        <Viewbox Width="14"
                                 Height="14"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Fill="Transparent"
                                  Data="M2,2 L12,12 M12,2 L2,12"/>
                        </Viewbox>
                    </Panel>
                </Button>
            </Grid>
            <TextBlock Text="Checklist reminders and deadline notifications. Edit one to change when it fires, or remove it."
                       FontSize="{DynamicResource Font13}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="RemindersEmpty"
                       Text="No reminders yet."
                       FontSize="{DynamicResource Font14}"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       IsVisible="False"/>
            <StackPanel x:Name="ReminderRows" Spacing="8"/>
        </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsPanel"
                  Grid.Row="2"
                  IsVisible="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="14"
                        Background="{DynamicResource AccentBrush}">
                    <Path Width="24"
                          Height="24"
                          Stretch="Uniform"
                          Fill="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M19.14,12.94c0.04-0.31,0.06-0.63,0.06-0.94c0-0.31-0.02-0.63-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.37,4.8,11.69,4.8,12s0.02,0.63,0.06,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                </Border>
                <StackPanel Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               FontSize="{DynamicResource Font28}"
                               FontWeight="Bold"/>
                    <TextBlock Text="Appearance and updates"
                               FontSize="{DynamicResource Font14}"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Back"
                        Classes="settings-back"
                        VerticalAlignment="Center"
                        Click="CloseSettings_Click"/>
            </Grid>

            <TextBlock Classes="settings-section" Text="Appearance"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="settings-icon">
                            <Path Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  Fill="Transparent"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,2 V4.5 M12,19.5 V22 M4.9,4.9 L6.7,6.7 M17.3,17.3 L19.1,19.1 M2,12 H4.5 M19.5,12 H22 M4.9,19.1 L6.7,17.3 M17.3,6.7 L19.1,4.9"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Theme"
                                       FontSize="{DynamicResource Font16}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Choose how Super Dev looks"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Classes="appearance-choice theme-card" Tag="System" Click="Theme_Click">
                            <Grid>
                                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,18">
                                    <Path Classes="choice-icon" Width="26" Height="26" Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" HorizontalAlignment="Center" Data="M3,5 H21 V15 H3 Z M8,19 H16 M12,15 V19"/>
                                    <TextBlock Classes="choice-title" Text="System" HorizontalAlignment="Center"/>
                                    <TextBlock Classes="choice-hint" Text="Follow system theme" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="appearance-choice theme-card" Tag="Light" Click="Theme_Click">
                            <Grid>
                                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,18">
                                    <Path Classes="choice-icon" Width="26" Height="26" Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round" Fill="Transparent" HorizontalAlignment="Center" Data="M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,2 V4.5 M12,19.5 V22 M4.9,4.9 L6.7,6.7 M17.3,17.3 L19.1,19.1 M2,12 H4.5 M19.5,12 H22 M4.9,19.1 L6.7,17.3 M17.3,6.7 L19.1,4.9"/>
                                    <TextBlock Classes="choice-title" Text="Light" HorizontalAlignment="Center"/>
                                    <TextBlock Classes="choice-hint" Text="Always use light theme" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" Classes="appearance-choice theme-card" Tag="Dark" Click="Theme_Click">
                            <Grid>
                                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,18">
                                    <Path Classes="choice-icon choice-fill" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" Data="M15.5,3 A8,8 0 1 0 15.5,21 A6.2,6.2 0 1 1 15.5,3 Z"/>
                                    <TextBlock Classes="choice-title" Text="Dark" HorizontalAlignment="Center"/>
                                    <TextBlock Classes="choice-hint" Text="Always use dark theme" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="settings-icon">
                            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.4"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Accent color"
                                       FontSize="{DynamicResource Font16}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Pick a color to match your style"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Spacing="14"/>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="settings-icon">
                            <Path Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Fill="Transparent"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Density"
                                       FontSize="{DynamicResource Font16}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Control the spacing and layout size"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Classes="appearance-choice option-card" Tag="Comfortable" Click="Density_Click">
                            <Grid>
                                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Path Grid.Column="0" Classes="choice-icon" Width="22" Height="22" Stretch="Uniform" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent" VerticalAlignment="Center" Data="M4,6 H7 M10,6 H20 M4,12 H7 M10,12 H20 M4,18 H7 M10,18 H20"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="choice-title" Text="Comfortable"/>
                                        <TextBlock Classes="choice-hint" Text="More spacing for relaxed use"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="appearance-choice option-card" Tag="Compact" Click="Density_Click">
                            <Grid>
                                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Path Grid.Column="0" Classes="choice-icon" Width="22" Height="22" Stretch="Uniform" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent" VerticalAlignment="Center" Data="M4,4 H7 M10,4 H20 M4,9 H7 M10,9 H20 M4,14 H7 M10,14 H20 M4,19 H7 M10,19 H20"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="choice-title" Text="Compact"/>
                                        <TextBlock Classes="choice-hint" Text="More content in less space"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="settings-icon">
                            <TextBlock Text="Aa"
                                       FontSize="{DynamicResource Font15}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Font size"
                                       FontSize="{DynamicResource Font16}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Adjust the text size across the app"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Classes="appearance-choice option-card" Tag="Small" Click="FontSize_Click">
                            <Grid>
                                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Classes="aa" Text="Aa" FontSize="{DynamicResource Font14}" Width="28"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="choice-title" Text="Small"/>
                                        <TextBlock Classes="choice-hint" Text="Smaller text"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="appearance-choice option-card" Tag="Medium" Click="FontSize_Click">
                            <Grid>
                                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Classes="aa" Text="Aa" FontSize="{DynamicResource Font20}" Width="32"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="choice-title" Text="Medium"/>
                                        <TextBlock Classes="choice-hint" Text="Default size"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" Classes="appearance-choice option-card" Tag="Large" Click="FontSize_Click">
                            <Grid>
                                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Classes="aa" Text="Aa" FontSize="{DynamicResource Font24}" Width="36"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="choice-title" Text="Large"/>
                                        <TextBlock Classes="choice-hint" Text="Larger text"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="settings-section" Text="Updates"/>

            <Border Classes="settings-card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="UpdateVersionText"
                                   FontSize="{DynamicResource Font15}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   FontSize="{DynamicResource Font13}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckUpdatesButton"
                                Content="Check for updates"
                                Classes="settings-back"
                                Click="CheckForUpdates_Click"/>
                        <Button x:Name="InstallUpdateButton"
                                Content="Install update"
                                Classes="settings-primary"
                                IsVisible="False"
                                Click="InstallUpdate_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoCheckBox" VerticalAlignment="Top">
                        <StackPanel Spacing="2" Margin="6,0,0,0">
                            <TextBlock Text="Check for new versions automatically"
                                       FontSize="{DynamicResource Font15}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Look for a newer release when Super Dev opens"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutoUpgradeBox" VerticalAlignment="Top">
                        <StackPanel Spacing="2" Margin="6,0,0,0">
                            <TextBlock Text="Install newer versions automatically"
                                       FontSize="{DynamicResource Font15}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Download and install when a newer release is found"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="ShortcutsPanel"
                  Grid.Row="2"
                  IsVisible="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Center"
                    Spacing="18">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <TextBlock Text="Keyboard shortcuts"
                           FontSize="{DynamicResource Font28}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Back"
                        Classes="settings-back"
                        VerticalAlignment="Center"
                        Click="CloseSettings_Click"/>
            </Grid>
            <TextBlock Text="Shortcuts depend on the focused control. Space and F2 stay with a text field while you are typing, and shortcuts do not run while a dialog is open. Highlighted keys are the ones used on this computer."
                       FontSize="{DynamicResource Font13}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"/>
            <StackPanel x:Name="ShortcutSections"
                        Spacing="18"/>
        </StackPanel>
    </ScrollViewer>

    <Border x:Name="ToastHost"
            Grid.RowSpan="3"
            IsVisible="False"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="24,0,24,28"
            Padding="14,8"
            Background="{DynamicResource BorderSubtleBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ZIndex="20">
        <TextBlock x:Name="ToastText"
                   FontSize="{DynamicResource Font13}"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Border>
</Grid>

</Window>